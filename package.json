{
  "name": "hotel-pms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env TZ=UTC next dev",
    "build": "cross-env TZ=UTC next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "cross-env TZ=UTC next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "cross-env TZ=UTC dotenv -e .env.local -- ts-node prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "create-admin": "dotenv -e .env.local -- ts-node scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.323.0",
    "mrz": "^5.0.2",
    "next": "14.1.0",
    "next-auth": "^4.24.15",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.2.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
