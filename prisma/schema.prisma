// prisma/schema.prisma
// PMS - Sistema de Gestión Hotelera para Casa de Aldea
// =====================================================
// AVISO DE SEGURIDAD (PCI-DSS):
// Este schema NO contiene ningún campo para almacenar datos de tarjetas de crédito
// (PAN, fecha de caducidad, CVC). Los pagos se gestionan externamente
// mediante TPV físico y transferencias bancarias.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" (PgBouncer, puerto 6543 en Supabase) — la usa la app
  // en tiempo de ejecución, apta para entornos serverless (Vercel).
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) — la necesitan `prisma migrate` y
  // `prisma db push`, el pooler no soporta esas operaciones.
  directUrl = env("DIRECT_URL")
}

// ─── HABITACIONES ────────────────────────────────────────────────────────────
model Room {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int
  basePrice   Decimal  @db.Decimal(10, 2)
  isClean     Boolean  @default(true)
  amenities   String[] @default([])
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Mapeo al Channel Manager (Channex) — se rellena tras crear el
  // room type y el rate plan correspondientes en el dashboard de Channex.
  channexRoomTypeId String?
  channexRatePlanId String?

  bookings Booking[]

  @@map("rooms")
}

// ─── HUÉSPEDES ────────────────────────────────────────────────────────────────
model Guest {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  documentId String   // DNI / NIE / Pasaporte — NUNCA datos bancarios
  email      String
  phone      String?
  nationality String? @default("ES")
  birthDate  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings Booking[]

  @@map("guests")
}

// ─── RESERVAS ─────────────────────────────────────────────────────────────────
model Booking {
  id           String        @id @default(cuid())
  guestId      String
  roomId       String
  checkInDate  DateTime      @db.Date
  checkOutDate DateTime      @db.Date
  totalAmount  Decimal       @db.Decimal(10, 2)
  status       BookingStatus @default(PENDING)
  source       BookingSource @default(WEB)
  depositPaid  Boolean       @default(false)
  notes        String?
  adults       Int           @default(1)
  children     Int           @default(0)

  // Datos del Channel Manager externo (si aplica)
  externalId   String?       @unique // ID desde Channex u otro Channel Manager
  channelRef   String?       // Referencia del canal

  // TPV Virtual (Stripe) — solo IDs, nunca datos de tarjeta (ver aviso PCI-DSS arriba)
  stripeCustomerId      String?
  stripePaymentMethodId String?
  stripePaymentIntentId String?

  // Precheckin (el huésped completa/corrige sus datos antes de llegar)
  precheckinCompletedAt DateTime?

  // Ficha Policial / SES.HOSPEDAJES (Ministerio del Interior)
  sesSubmittedAt     DateTime?
  sesSubmissionError String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  guest    Guest     @relation(fields: [guestId], references: [id])
  room     Room      @relation(fields: [roomId], references: [id])
  invoices Invoice[]

  @@map("bookings")
}

// ─── FACTURAS ─────────────────────────────────────────────────────────────────
model Invoice {
  id        String   @id @default(cuid())
  bookingId String
  issueDate DateTime @default(now())
  total     Decimal  @db.Decimal(10, 2) // Alojamiento + servicios adicionales
  tax       Decimal  @db.Decimal(10, 2) // IVA (10%, tipo reducido de hostelería)
  subtotal  Decimal  @db.Decimal(10, 2)
  pdfUrl    String?  // URL al PDF generado (almacenado externamente)
  invoiceNumber String @unique // Número de factura correlativo
  isPaid    Boolean  @default(false)
  paymentMethod PaymentMethod? // Cómo se cobró (tarjeta, efectivo...); se fija al marcar como pagada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id])
  extras  InvoiceExtra[]

  @@map("invoices")
}

// Servicios adicionales facturados junto al alojamiento (desayuno, etc.).
model InvoiceExtra {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  amount      Decimal  @db.Decimal(10, 2) // Importe con IVA incluido, igual que el total de la reserva

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_extras")
}

// ─── GASTOS ───────────────────────────────────────────────────────────────────
model Expense {
  id            String        @id @default(cuid())
  date          DateTime      @db.Date
  category      String
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(OTHER)
  supplier      String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@map("expenses")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// ─── CONTROL DE CAJA ────────────────────────────────────────────────────────────
// Arqueo diario del efectivo físico — independiente de Facturas/Stripe, el
// personal anota a mano cada movimiento de efectivo, igual que en un TPV físico.
model CashSession {
  id              String            @id @default(cuid())
  date            DateTime          @db.Date
  openingBalance  Decimal           @db.Decimal(10, 2)
  closingBalance  Decimal?          @db.Decimal(10, 2)
  expectedBalance Decimal?          @db.Decimal(10, 2)
  difference      Decimal?          @db.Decimal(10, 2)
  status          CashSessionStatus @default(OPEN)
  notes           String?
  openedAt        DateTime          @default(now())
  closedAt        DateTime?

  movements CashMovement[]

  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id])
  type          CashMovementType
  concept       String
  amount        Decimal          @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())

  @@map("cash_movements")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

// ─── PRESUPUESTOS ─────────────────────────────────────────────────────────────
// Foto del precio en el momento del presupuesto (sin FK a Room): no reserva
// inventario ni se ve afectado si luego cambia el precio o se borra la habitación.
model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique // PRES-YYYY-NNNN
  guestName     String
  guestEmail    String
  guestPhone    String?
  roomName      String
  pricePerNight Decimal     @db.Decimal(10, 2)
  checkInDate   DateTime    @db.Date
  checkOutDate  DateTime    @db.Date
  subtotal      Decimal     @db.Decimal(10, 2)
  tax           Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime    @db.Date
  notes         String?
  convertedBookingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotes")
}

enum QuoteStatus {
  DRAFT    // Borrador
  SENT     // Enviado al cliente
  ACCEPTED // Aceptado (puede o no estar ya convertido en reserva)
  REJECTED // Rechazado
  EXPIRED  // Caducado (pasada la fecha de validez)
}

// ─── USUARIOS (backoffice) ─────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("users")
}

// ─── ENUMERACIONES ────────────────────────────────────────────────────────────
enum BookingStatus {
  PENDING    // Reserva creada, pendiente de confirmación/pago
  CONFIRMED  // Confirmada y con depósito/pago recibido
  CANCELLED  // Cancelada
  CHECKED_IN  // Huésped en el establecimiento
  CHECKED_OUT // Huésped ha salido
}

enum BookingSource {
  WEB      // Motor de reservas propio
  BOOKING  // Booking.com (via Channel Manager)
  AIRBNB   // Airbnb (via Channel Manager)
  MANUAL   // Entrada manual por staff
  CHANNEX  // Cualquier canal via Channex
  PHONE    // Reserva por teléfono
}
