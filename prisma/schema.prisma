// prisma/schema.prisma
// PMS - Sistema de Gestión Hotelera para Casa de Aldea
// =====================================================
// AVISO DE SEGURIDAD (PCI-DSS):
// Este schema NO contiene ningún campo para almacenar datos de tarjetas de crédito
// (PAN, fecha de caducidad, CVC). Los pagos se gestionan externamente
// mediante TPV físico y transferencias bancarias.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" (PgBouncer, puerto 6543 en Supabase) — la usa la app
  // en tiempo de ejecución, apta para entornos serverless (Vercel).
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432) — la necesitan `prisma migrate` y
  // `prisma db push`, el pooler no soporta esas operaciones.
  directUrl = env("DIRECT_URL")
}

// ─── HABITACIONES ────────────────────────────────────────────────────────────
model Room {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int
  basePrice   Decimal  @db.Decimal(10, 2)
  type        RoomType @default(DOUBLE)
  isClean     Boolean  @default(true)
  amenities   String[] @default([])
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Mapeo al Channel Manager (Beds24) — se rellena con el "Room Id" (numérico)
  // de esta habitación en el dashboard de Beds24, tras crearla allí.
  beds24RoomId String?

  bookings Booking[]

  @@map("rooms")
}

enum RoomType {
  DOUBLE
  APARTMENT
}

// ─── HUÉSPEDES ────────────────────────────────────────────────────────────────
model Guest {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  documentId  String // DNI / NIE / Pasaporte — NUNCA datos bancarios
  email       String
  phone       String?
  nationality String?   @default("ES")
  birthDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[]

  @@map("guests")
}

// ─── RESERVAS ─────────────────────────────────────────────────────────────────
model Booking {
  id           String        @id @default(cuid())
  guestId      String
  roomId       String?
  roomType     RoomType      @default(DOUBLE)
  checkInDate  DateTime      @db.Date
  checkOutDate DateTime      @db.Date
  totalAmount  Decimal       @db.Decimal(10, 2)
  status       BookingStatus @default(PENDING)
  source       BookingSource @default(WEB)
  depositPaid  Boolean       @default(false)
  notes        String?
  adults       Int           @default(1)
  children     Int           @default(0)

  // Datos del Channel Manager externo (si aplica)
  externalId String? @unique // ID de la reserva en Beds24 u otro Channel Manager
  channelRef String? // Referencia del canal (p.ej. "Booking.com", "Airbnb")

  // TPV Virtual (Stripe) — solo IDs, nunca datos de tarjeta (ver aviso PCI-DSS arriba)
  stripeCustomerId      String?
  stripePaymentMethodId String?
  stripePaymentIntentId String?

  // Precheckin (el huésped completa/corrige sus datos antes de llegar)
  precheckinCompletedAt DateTime?

  // Ficha Policial / SES.HOSPEDAJES (Ministerio del Interior)
  sesSubmittedAt     DateTime?
  sesSubmissionError String?

  // App de huéspedes — acceso mediante código generado por el personal (web o
  // app de staff), sin registro. El código se guarda hasheado; nunca en claro.
  guestAccessCodeHash  String?
  // Se pisa cada vez que el personal regenera el código — sirve para saber si
  // hay que volver a pedirle el nombre al huésped (nueva estancia = nuevo código).
  guestAccessCodeSetAt DateTime?
  // Nombre "de cortesía" que el huésped introduce la primera vez que usa el
  // código vigente, solo para personalizar la app (saludo, chat) — no toca los
  // datos legales de Guest (documento, ficha de viajero, etc.).
  guestDisplayName     String?
  guestLastLoginAt     DateTime?
  // Copia en claro SOLO para los códigos generados automáticamente por el cron
  // de llegadas (nadie hizo clic en "generar", así que nadie lo vio en el
  // momento). Se muestra en el panel para que recepción se lo dé al huésped
  // en persona, y se borra en cuanto el huésped hace login o el personal
  // genera/regenera/revoca el código manualmente. Los códigos generados a
  // mano NUNCA pasan por aquí (siguen sin persistirse en claro).
  guestAccessCodePlain String?

  // Oculta el chat de recepción al huésped (app de huéspedes) sin borrar
  // nada — el personal lo sigue viendo entero en el histórico de la reserva
  // (web y app de staff). Se pone sola al hacer checkout/cancelar (junto a
  // la revocación del código de acceso) y también se puede forzar a mano
  // con un botón. Solo oculta mensajes anteriores a esta fecha: si el
  // huésped vuelve a escribir después, esos nuevos mensajes sí se ven.
  guestChatClearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guest           Guest                 @relation(fields: [guestId], references: [id])
  room            Room?                 @relation(fields: [roomId], references: [id])
  invoices        Invoice[]
  serviceRequests GuestServiceRequest[]
  messages        GuestMessage[]

  @@map("bookings")
}

// ─── APP DE HUÉSPEDES ──────────────────────────────────────────────────────────
// Peticiones diarias que el huésped marca desde la app (desayuno del día
// siguiente, cena del peregrino, limpieza de habitación). Una fila por
// combinación reserva+día+tipo — volver a marcar/desmarcar reutiliza la misma
// fila (ver @@unique) para conservar el historial en vez de borrar y recrear.
model GuestServiceRequest {
  id        String             @id @default(cuid())
  bookingId String
  date      DateTime           @db.Date
  type      GuestServiceType
  status    GuestServiceStatus @default(REQUESTED)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, date, type])
  @@map("guest_service_requests")
}

enum GuestServiceType {
  BREAKFAST
  DINNER
  CLEANING
}

enum GuestServiceStatus {
  REQUESTED
  CANCELLED
}

// Chat entre el huésped y el personal (recepción). Vive en el hilo de su
// reserva — no hay conversaciones separadas de la estancia a la que pertenecen.
model GuestMessage {
  id        String        @id @default(cuid())
  bookingId String
  sender    MessageSender
  body      String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
  @@map("guest_messages")
}

enum MessageSender {
  GUEST
  STAFF
}

// Guía de rutas de senderismo/Camino de Santiago alrededor del alojamiento —
// contenido editorial que gestiona el personal, no ligado a ninguna reserva.
// Sin fotos ni track GPX por ahora: la app de huéspedes usa icono + color en
// su lugar (evita hacer pasar una foto de stock por una foto real del
// sitio); si se añaden más adelante, este es el modelo al que colgarlas.
model Route {
  id               String          @id @default(cuid())
  name             String
  // Texto libre (p.ej. "Costa", "Cultural", "Montaña") a propósito: no es un
  // enum para que el personal pueda añadir una categoría nueva sin necesitar
  // una migración.
  category         String
  // Etapa oficial de un Camino de Santiago — se destaca en la app con la
  // tarjeta grande y el badge de concha.
  isCaminoStage    Boolean         @default(false)
  distanceKm       Decimal         @db.Decimal(5, 1)
  // Distancia en coche desde el hotel hasta el inicio de la ruta — para
  // poder ordenar por cercanía en la app de huéspedes. Nullable porque las
  // rutas creadas antes de este campo no la tienen todavía.
  distanceFromHotelKm Decimal?      @db.Decimal(5, 1)
  durationMin      Int
  elevationGainM   Int             @default(0)
  elevationLossM   Int             @default(0)
  difficulty       RouteDifficulty @default(MODERATE)
  // Nombre de icono de Ionicons (@expo/vector-icons) — se valida contra una
  // lista blanca en el servicio, no aquí. Se sigue usando como respaldo
  // (fondo de color + icono) cuando la ruta no tiene imageUrl.
  icon             String          @default("walk-outline")
  // Foto subida desde el admin (Vercel Blob) — opcional, ver /api/routes/upload.
  imageUrl         String?
  description      String
  pointsOfInterest String[]        @default([])
  // Permite ocultarla (cierre estacional, obras) sin borrar el contenido.
  isPublished      Boolean         @default(true)
  // Orden manual dentro de "más rutas cercanas" (el destino de Camino
  // siempre va primero si isCaminoStage = true, independientemente de esto).
  order            Int             @default(0)

  stops     RouteStop[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("routes")
}

// Paradas georreferenciadas de una ruta, en orden — para generar el enlace
// de Google Maps con indicaciones desde la ubicación del huésped pasando por
// cada parada (waypoints) hasta la última (destino).
model RouteStop {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name    String
  lat     Decimal @db.Decimal(9, 6)
  lng     Decimal @db.Decimal(9, 6)
  order   Int     @default(0)

  @@map("route_stops")
}

enum RouteDifficulty {
  EASY
  MODERATE
  HARD
}

// ─── FACTURAS ─────────────────────────────────────────────────────────────────
model Invoice {
  id            String         @id @default(cuid())
  bookingId     String
  issueDate     DateTime       @default(now())
  total         Decimal        @db.Decimal(10, 2) // Alojamiento + servicios adicionales
  tax           Decimal        @db.Decimal(10, 2) // IVA (10%, tipo reducido de hostelería)
  subtotal      Decimal        @db.Decimal(10, 2)
  pdfUrl        String? // URL al PDF generado (almacenado externamente)
  invoiceNumber String         @unique // Número de factura correlativo
  isPaid        Boolean        @default(false)
  paymentMethod PaymentMethod? // Cómo se cobró (tarjeta, efectivo...); se fija al marcar como pagada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id])
  extras  InvoiceExtra[]

  @@map("invoices")
}

// Servicios adicionales facturados junto al alojamiento (desayuno, etc.).
model InvoiceExtra {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(10, 2) // Importe con IVA incluido, igual que el total de la reserva

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_extras")
}

// ─── GASTOS ───────────────────────────────────────────────────────────────────
model Expense {
  id            String        @id @default(cuid())
  date          DateTime      @db.Date
  category      String
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(OTHER)
  supplier      String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@map("expenses")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// ─── CONTROL DE CAJA ────────────────────────────────────────────────────────────
// Arqueo diario del efectivo físico — independiente de Facturas/Stripe, el
// personal anota a mano cada movimiento de efectivo, igual que en un TPV físico.
model CashSession {
  id              String            @id @default(cuid())
  date            DateTime          @db.Date
  openingBalance  Decimal           @db.Decimal(10, 2)
  closingBalance  Decimal?          @db.Decimal(10, 2)
  expectedBalance Decimal?          @db.Decimal(10, 2)
  difference      Decimal?          @db.Decimal(10, 2)
  status          CashSessionStatus @default(OPEN)
  notes           String?
  openedAt        DateTime          @default(now())
  closedAt        DateTime?

  movements CashMovement[]

  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id])
  type          CashMovementType
  concept       String
  amount        Decimal          @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())

  @@map("cash_movements")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

// ─── PRESUPUESTOS ─────────────────────────────────────────────────────────────
// Foto del precio en el momento del presupuesto (sin FK a Room): no reserva
// inventario ni se ve afectado si luego cambia el precio o se borra la habitación.
model Quote {
  id                 String      @id @default(cuid())
  quoteNumber        String      @unique // PRES-YYYY-NNNN
  guestName          String
  guestEmail         String
  guestPhone         String?
  roomName           String
  pricePerNight      Decimal     @db.Decimal(10, 2)
  checkInDate        DateTime    @db.Date
  checkOutDate       DateTime    @db.Date
  subtotal           Decimal     @db.Decimal(10, 2)
  tax                Decimal     @db.Decimal(10, 2)
  total              Decimal     @db.Decimal(10, 2)
  status             QuoteStatus @default(DRAFT)
  validUntil         DateTime    @db.Date
  notes              String?
  convertedBookingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotes")
}

enum QuoteStatus {
  DRAFT // Borrador
  SENT // Enviado al cliente
  ACCEPTED // Aceptado (puede o no estar ya convertido en reserva)
  REJECTED // Rechazado
  EXPIRED // Caducado (pasada la fecha de validez)
}

// ─── USUARIOS (backoffice) ─────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  pushTokens StaffPushToken[]

  @@map("users")
}

// Ajustes globales del hotel — una sola fila ("singleton"). De momento solo
// si el servicio de cena está activo (temporada de peregrinos); se puede
// ampliar añadiendo columnas cuando haga falta otro ajuste global.
model HotelSetting {
  id                   String   @id @default("singleton")
  dinnerServiceEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("hotel_settings")
}

// Token de dispositivo (APNs, iOS nativo) para mandar notificaciones push al
// personal — un usuario puede tener varios (varios dispositivos).
model StaffPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_push_tokens")
}

// ─── ENUMERACIONES ────────────────────────────────────────────────────────────
enum BookingStatus {
  PENDING // Reserva creada, pendiente de confirmación/pago
  CONFIRMED // Confirmada y con depósito/pago recibido
  CANCELLED // Cancelada
  CHECKED_IN // Huésped en el establecimiento
  CHECKED_OUT // Huésped ha salido
}

enum BookingSource {
  WEB // Motor de reservas propio
  BOOKING // Booking.com (via Channel Manager)
  AIRBNB // Airbnb (via Channel Manager)
  MANUAL // Entrada manual por staff
  BEDS24 // Cualquier canal via Beds24 sin mapeo específico (Booking/Airbnb arriba)
  PHONE // Reserva por teléfono
}
