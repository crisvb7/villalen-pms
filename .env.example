# Copia este archivo como .env.local y completa los valores
# =============================================
# BASE DE DATOS (PostgreSQL / Supabase)
# =============================================
# Local: basta con DATABASE_URL apuntando a tu Postgres; deja DIRECT_URL igual.
# Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL = conexión "Transaction pooler" (puerto 6543, con ?pgbouncer=true)
#   DIRECT_URL   = conexión "Direct connection" (puerto 5432) — la usan las migraciones
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hotel_pms?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/hotel_pms?schema=public"

# =============================================
# SEGURIDAD
# =============================================
NEXTAUTH_SECRET="cambia_esto_por_un_secreto_seguro_en_produccion"
NEXTAUTH_URL="http://localhost:3000"
# Firma los JWT que usa la app móvil de staff (login en /api/mobile/auth/login).
# Genera uno distinto de NEXTAUTH_SECRET, p.ej.: openssl rand -base64 32
MOBILE_JWT_SECRET="cambia_esto_por_otro_secreto_seguro_en_produccion"
# Firma los JWT que usa la app de HUÉSPEDES (login por código en
# /api/guest-app/auth/login). Genera uno distinto de los otros dos.
GUEST_JWT_SECRET="cambia_esto_por_otro_secreto_seguro_en_produccion"
# Credenciales para `npm run create-admin` (crea/actualiza un usuario de /admin/login).
# No se guardan aquí de forma permanente: pásalas solo al ejecutar el comando.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# =============================================
# CHANNEL MANAGER (Beds24) — dejar vacío para no activar nada todavía
# =============================================
# Mientras estas variables no estén rellenas, todo el módulo de Beds24 se
# queda inerte (igual que pasaba con Channex): ni se empuja disponibilidad
# ni el webhook exige nada. Así conviven en el mismo despliegue el PMS
# actual (que sigue siendo el único que distribuye a los canales) y este
# código ya listo para el día del corte — ver README, sección "Channel
# Manager (Beds24)" para el procedimiento de la transición.
#
# Entrante: secreto incrustado en la URL del webhook que registres en Beds24
# (Settings → Properties → Access → Booking webhooks), como
# .../api/webhooks/beds24?secret=ESTE_VALOR
BEDS24_WEBHOOK_SECRET="tu_secreto_de_webhook_aqui"
# Saliente: credenciales para empujar disponibilidad y tarifas hacia Beds24.
# BEDS24_REFRESH_TOKEN se obtiene UNA VEZ a mano: genera un "invite code" en
# Settings → Account → Access de tu cuenta Beds24 y cámbialo por un refresh
# token (ver README). BEDS24_PROPERTY_ID es el "Prop Id" numérico de tu
# alojamiento en Beds24.
BEDS24_REFRESH_TOKEN=""
BEDS24_PROPERTY_ID=""
# Secreto para proteger el cron de reconciliación diaria (/api/cron/beds24-sync).
CRON_SECRET="genera_un_secreto_aleatorio_aqui"

# =============================================
# TPV VIRTUAL (Stripe)
# =============================================
# Claves de https://dashboard.stripe.com/apikeys (usa las de test primero).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Firma del webhook: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# =============================================
# TPV VIRTUAL (Redsys / Caja Rural) — EN PREPARACIÓN, TODAVÍA SIN USAR
# =============================================
# ⚠️ Estas variables están reservadas para cuando Caja Rural dé de alta el
# TPV Virtual con tokenización (pago por referencia / COF) y facilite acceso
# al entorno de pruebas — ver README, sección "TPV Virtual". Por ahora el
# pago online (/reserva) sigue funcionando con Stripe (sección de arriba);
# rellenar esto NO activa nada todavía, el código que las lea aún no existe.
# Al pedir el alta a Caja Rural, solicita explícitamente:
#   1. Soporte de tokenización/pago por referencia (COF), no solo cobro simple.
#   2. Acceso al entorno de pruebas (sandbox), con sus propias credenciales.
#   3. Si activan integración iNSITE (formulario de tarjeta embebido) además
#      de la de redirección — iNSITE es la que mantiene la tarjeta fuera de
#      nuestro servidor, igual que hace Stripe Elements ahora.
#
# Código de comercio (FUC), asignado por Redsys/Caja Rural al dar de alta el TPV.
REDSYS_MERCHANT_CODE=""
# Número de terminal (normalmente "1", o el que os asignen si hay varios).
REDSYS_TERMINAL=""
# Clave de firma HMAC SHA-512 del terminal, en Base64 tal cual la entrega
# Caja Rural (Módulo de administración → Consulta de claves de comercio).
REDSYS_SECRET_KEY=""
# "test" apunta a sis-t.redsys.es (sandbox), "production" a sis.redsys.es
REDSYS_ENVIRONMENT="test"

# =============================================
# FICHA POLICIAL (SES.HOSPEDAJES - Ministerio del Interior)
# =============================================
# Credenciales del "Servicio Web" (distintas de las del portal), se obtienen
# tras darte de alta en sede.interior.gob.es y activar el envío por web service.
# El usuario del Servicio Web sigue el patrón "NIF+WS" (o "CIF+WS" si es
# sociedad) — termina siempre en las letras "WS".
SES_WS_USERNAME=""
SES_WS_PASSWORD=""
# "test" apunta a pre-ses.mir.es, "production" a ses.mir.es
SES_ENVIRONMENT="test"
# Código de arrendador (10 dígitos) — te lo asigna el Sistema de Hospedajes al
# darte de alta, es el mismo para todos tus alojamientos si tienes varios.
SES_LANDLORD_CODE=""
# Código de establecimiento (10 dígitos) — uno por cada alojamiento, te lo
# asigna el Sistema de Hospedajes al registrar Villalén como establecimiento.
SES_ESTABLISHMENT_CODE=""

# =============================================
# EMAILS TRANSACCIONALES (Resend)
# =============================================
# Clave de https://resend.com/api-keys
RESEND_API_KEY=""
# Hasta verificar un dominio propio en Resend, solo puedes enviar desde
# onboarding@resend.dev (o a tu propia cuenta de Resend).
EMAIL_FROM="Villalén <onboarding@resend.dev>"

# =============================================
# CONFIGURACIÓN DEL HOTEL
# =============================================
HOTEL_NAME="Villalén"
HOTEL_EMAIL="reservas@villalen.es"
HOTEL_PHONE="+34 985 857 093"
# Opcional: se muestra en el email de reservas pendientes de transferencia.
HOTEL_BANK_IBAN=""

# =============================================
# NOTIFICACIONES PUSH (APNs, app de gestión de staff)
# =============================================
# Apple Developer → Certificates, Identifiers & Profiles → Keys.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="es.villalen.pmsadmin"
# "development" mientras se instale compilando desde Xcode;
# "production" cuando la app se distribuya por TestFlight/App Store.
APNS_ENV="development"
# Contenido del .p8 descargado, en una sola línea con \n literales.
APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# =============================================
# ALMACENAMIENTO DE IMÁGENES (Vercel Blob)
# =============================================
# Fotos de rutas (app/api/routes/upload). Se genera sola al activar
# Vercel Blob Storage: Vercel → tu proyecto → Storage → Create Database → Blob.
BLOB_READ_WRITE_TOKEN=""
